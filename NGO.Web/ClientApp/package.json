{
  "name": "client-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start-pwa": "ng build && http-server -p 8080 -c-1 dist/ClientApp",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" && eslint --fix \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" && eslint \"src/**/*.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.12",
    "@angular/cdk": "^18.2.10",
    "@angular/common": "^18.2.9",
    "@angular/compiler": "^18.2.12",
    "@angular/core": "^18.2.12",
    "@angular/forms": "^18.2.9",
    "@angular/localize": "^18.2.9",
    "@angular/platform-browser": "^18.2.12",
    "@angular/platform-browser-dynamic": "^18.2.9",
    "@angular/router": "^18.2.9",
    "@angular/service-worker": "^18.2.9",
    "@ng-bootstrap/ng-bootstrap": "^17.0.1",
    "@ngrx/effects": "^18.1.1",
    "@ngrx/entity": "^18.1.1",
    "@ngrx/store": "^18.1.1",
    "@ngrx/store-devtools": "^18.1.1",
    "bootstrap": "4.5.2",
    "chart.js": "^4.4.5",
    "clipboard": "^2.0.11",
    "core-js": "^3.38.1",
    "country-state-city": "^3.2.1",
    "ngrx-store-localstorage": "^18.0.0",
    "ngx-clipboard": "^16.0.0",
    "ngx-toastr": "^19.0.0",
    "nouislider": "^15.8.1",
    "primeflex": "^3.3.1",
    "primeicons": "^7.0.0",
    "primeng": "^17.18.12",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "xlsx": "^0.18.5",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.10",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.9",
    "@eslint/js": "^9.19.0",
    "@types/chart.js": "^2.9.41",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^22.8.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.3",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jasmine-core": "^5.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.23.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,html,css,scss}": [
      "prettier --write",
      "git add"
    ]
  }
}
